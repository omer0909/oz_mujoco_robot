<mujoco model="simple_two_wheel_robot">

    <compiler angle="degree"/>

    <option
        timestep="0.002"
        gravity="0 0 -9.81"
        integrator="implicit"
        cone="elliptic"/>

    <default>
        <joint damping="0.05"/>
        <geom contype="1"
              conaffinity="1"
              friction="1 0.005 0.0001"
              solimp="0.9 0.95 0.001"/>
    </default>

    <worldbody>

        <geom
            name="empty_box"
            type="box"
            size="1.0 1.0 1.0"
            rgba="0.2 0.5 0.9 1"
            mass="1"
            pos="2 0 0.5"/>

        <light
            diffuse="0.8 0.8 0.8"
            pos="0 0 3"
            dir="0 0 -1"/>

        <geom
            name="floor"
            type="plane"
            size="5 5 0.1"
            rgba="0.8 0.8 0.8 1"
            friction="1 0.005 0.0001"/>

        <body name="chassis" pos="0 0 0.15">

            <freejoint/>

            <geom
                name="body_box"
                type="box"
                size="0.1 0.1 0.05"
                rgba="0.2 0.5 0.9 1"
                mass="1"/>



            <body name="lidar" pos="0 0 0.08">
                <geom
                    name="lidar_geom"
                    type="cylinder"
                    size="0.02 0.02"
                    rgba="0.9 0.1 0.1 1"
                    mass="0.05"/>
            </body>

            <body name="wheel_left" pos="-0.05 0.115 0">

                <joint
                    name="wheel_left_joint"
                    type="hinge"
                    axis="0 1 0"/>

                <geom
                    name="wheel_left_geom"
                    type="cylinder"
                    size="0.06 0.01"
                    euler="90 0 0"
                    rgba="0.1 0.1 0.1 1"
                    mass="0.1"/>

            </body>

            <body name="wheel_right" pos="-0.05 -0.115 0">

                <joint
                    name="wheel_right_joint"
                    type="hinge"
                    axis="0 1 0"/>

                <geom
                    name="wheel_right_geom"
                    type="cylinder"
                    size="0.06 0.01"
                    euler="90 0 0"
                    rgba="0.1 0.1 0.1 1"
                    mass="0.1"/>

            </body>

            <body name="caster_left" pos="0.08 -0.04 -0.04">
                <geom
                    type="sphere"
                    size="0.02"
                    mass="0.02"
                    condim="1"
                    friction="0 0 0"/>
            </body>

            <body name="caster_right" pos="0.08 0.04 -0.04">
                <geom
                    type="sphere"
                    size="0.02"
                    mass="0.02"
                    condim="1"
                    friction="0 0 0"/>
            </body>

        </body>

    </worldbody>

    <actuator>

        <velocity
            name="wheel_left_motor"
            joint="wheel_left_joint"
            kv="5"
            ctrlrange="-10 10"/>

        <velocity
            name="wheel_right_motor"
            joint="wheel_right_joint"
            kv="5"
            ctrlrange="-10 10"/>

    </actuator>

</mujoco>
